# v1 needs none of these: it runs on fictional seed data.
# Fill them in .env.local as you wire each part (replica/backend.md).

# Postgres / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Licensed data provider(s), your own keys
STATS_PROVIDER_API_KEY=
ODDS_PROVIDER_API_KEY=

# Stripe (test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Email
RESEND_API_KEY=
EMAIL_FROM=
