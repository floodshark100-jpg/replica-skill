{
  "_about": "Linecraft tokens. Dark-first analytics UI. Role names from replica-design; values are Linecraft's own palette. Check with: python3 ../../../replica-design/contrast.py tokens.json",
  "color": {
    "bg": "#0e1116",
    "surface": "#161a21",
    "surface-2": "#1e232c",
    "border": "#2a303a",
    "border-input": "#6f7a89",
    "text": "#eef1f5",
    "text-muted": "#9aa4b2",
    "accent": "#f4b740",
    "on-accent": "#1b1404",
    "danger": "#ff7a7a",
    "success": "#43d39e",
    "warning": "#f4b740",
    "neutral": "#b9c2cf"
  },
  "pairs": [
    ["text", "bg"], ["text", "surface"], ["text", "surface-2"],
    ["text-muted", "bg"], ["text-muted", "surface"], ["text-muted", "surface-2"],
    ["on-accent", "accent"], ["accent", "bg"], ["accent", "surface"],
    ["danger", "surface"], ["success", "surface"], ["neutral", "surface"],
    ["danger", "surface-2"], ["success", "surface-2"],
    ["border-input", "bg", "ui"], ["border-input", "surface", "ui"], ["accent", "surface", "ui"]
  ],
  "font": {
    "sans": "Inter, system-ui, -apple-system, Segoe UI, Roboto, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "type": {
    "xs": {"size": 12, "line": 16, "weight": 500},
    "sm": {"size": 14, "line": 20, "weight": 400},
    "base": {"size": 16, "line": 24, "weight": 400},
    "lg": {"size": 20, "line": 28, "weight": 600},
    "xl": {"size": 28, "line": 34, "weight": 700},
    "display": {"size": 44, "line": 48, "weight": 800}
  },
  "space": [0, 4, 8, 12, 16, 24, 32, 48, 64],
  "radius": {"sm": 6, "md": 10, "lg": 16, "pill": 999},
  "shadow": {
    "card": "0 1px 2px rgba(0,0,0,.35), 0 2px 8px rgba(0,0,0,.25)",
    "pop": "0 12px 32px rgba(0,0,0,.5)"
  },
  "motion": {"fast": "120ms", "base": "200ms", "ease": "cubic-bezier(.2,.8,.2,1)"}
}
