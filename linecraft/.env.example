# v1 needs none of these: it runs on fictional seed data.
# Fill them in .env.local as you wire each part (replica/backend.md).

# Postgres / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Live odds from The Odds API (https://the-odds-api.com). Setting the key
# switches the whole app from demo data to live lines and prices.
ODDS_API_KEY=
# Optional, defaults shown. Every refresh costs quota: see replica/backend.md.
# ODDS_API_REGIONS=us                  # us, us2, uk, eu, au; comma separated
# ODDS_API_BOOKMAKERS=                 # e.g. draftkings,fanduel; overrides regions
# ODDS_API_TTL_SECONDS=1800            # how long a sport's snapshot is reused (60-86400)
# ODDS_API_MAX_EVENTS=6                # games fetched per sport (1-30)
# ODDS_API_HOURS_AHEAD=36              # how far ahead the slate looks (1-168)
# ODDS_API_SCAN_TTL_SECONDS=120        # arbitrage scan (/arbs): how often it may refetch (30-3600)
# ODDS_API_INPLAY_HOURS=4              # arbitrage scan: include games that started this long ago (0-12)
# ODDS_API_MIN_CREDITS=25              # pause all odds fetching below this many credits left (0 = never)

# Private deployment: every request needs this password (HTTP Basic auth, any username).
# Set it whenever ODDS_API_KEY is set on a public host.
ACCESS_PASSWORD=

# Stats provider for game logs (not wired yet)
STATS_PROVIDER_API_KEY=

# Stripe (test keys until launch)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=

# Email
RESEND_API_KEY=
EMAIL_FROM=
